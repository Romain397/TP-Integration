{
  "name": "devsecops-tp",
  "version": "1.0.0",
  "private": true,
  "description": "TP 3 — API Node.js sécurisée et pipeline DevSecOps",
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "baseline:prepare": "node scripts/prepare-baseline.js"
  },
  "dependencies": {
    "express": "4.22.3",
    "express-rate-limit": "8.7.3",
    "lodash": "4.18.1"
  },
  "devDependencies": {
    "jest": "30.5.2",
    "supertest": "7.3.1"
  },
  "jest": {
    "roots": [
      "<rootDir>/tests"
    ],
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/app.js"
    ],
    "coverageReporters": [
      "text",
      "json-summary",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    }
  }
}
